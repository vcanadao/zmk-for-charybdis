#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

/* --- COLORES --- */
#define LILA      280
#define AZUL      240
#define ROJO      0
#define AMARILLO  60

/* --- DEFINICIONES MAC ESPAÑOL --- */
#define ES_CARET  LS(LBKT)
#define ES_PERC   LS(N5)
#define ES_TILDE  RA(SEMI)
#define ES_ACUTE  SQT
#define ES_AT     RA(N2)
#define ES_SEMI   LS(COMMA)
#define ES_EQL    LS(N0)
#define ES_PIPE   RA(N1)
#define ES_SLSH   LS(N7)
#define ES_UNDS   LS(SLASH)
#define ES_HASH   RA(N3)
#define ES_EXCL   LS(N1)
#define ES_COLN   LS(DOT)
#define ES_DOT    DOT
#define ES_COMM   COMMA
#define ES_AMPS   LS(N6)
#define ES_MINS   SLASH
#define ES_PLUS   RBKT
#define ES_ASTR   LS(RBKT)
#define ES_LPAR   LS(N8)
#define ES_RPAR   LS(N9)
#define ES_LABK   GRAVE
#define ES_RABK   LS(GRAVE)
#define ES_QUES   LS(MINUS)
#define ES_BSLH   RA(LS(N7))
#define ES_DLR    LS(N4)
#define ES_IQUE   LS(EQUAL)

/ {
    macros {
        to_l0: to_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 0>, <&macro_tap &rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        to_l1: to_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 1>, <&macro_tap &rgb_ug RGB_COLOR_HSB(AZUL,100,50)>;
        };

        to_l2: to_l2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 2>, <&macro_tap &rgb_ug RGB_COLOR_HSB(RO
        };

        to_l3: to_l3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 3>, <&macro_tap &rgb_ug RGB_COLOR_HSB(AM
        };

        m_angle:     m_angle     { compatible = "zmk,behavior-macro"; #binding-kp ES_LABK>, <&kp ES_RABK>, <&kp LEFT>; };
        m_parens:    m_parens    { compatible = "zmk,behavior-macro"; #binding-kp ES_LPAR>, <&kp ES_RPAR>, <&kp LEFT>; };
        m_braces:    m_braces    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(LBKT)>, <&kp RA(RBKT)>, <&kp LEFT>; };
        m_brackets:  m_brackets  { compatible = "zmk,behavior-macro"; #binding-kp RA(SQT)>, <&kp RA(BSLH)>, <&kp LEFT>; };
        m_quotes:    m_quotes    { compatible = "zmk,behavior-macro"; #binding-kp LS(N2)>, <&kp LS(N2)>, <&kp LEFT>; };
        m_s_quotes:  m_s_quotes  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SQT>, <&kp SQT>, <&kp LEFT>; };
        m_backticks: m_backticks { compatible = "zmk,behavior-macro"; #binding-kp LS(LBKT)>, <&kp LS(LBKT)>, <&kp LEFT>; };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        hm_shift: homerow_mods_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        td_ene:        td_ene        { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <160>; bindings = <&kp SEMI>,    <&kp ES_TILDE>; };
        td_y:          td_y          { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <160>; bindings = <&kp Y>,       <&kp ES_ACUTE>; };
        td_u_at:       td_u_at       { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <160>; bindings = <&kp U>,       <&kp ES_AT>;    };
        td_comm_dot:   td_comm_dot   { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_COMM>, <&kp ES_DOT>;   };
        td_perc_caret: td_perc_caret { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <180>; bindings = <&kp ES_PERC>, <&kp ES_CARET>; };
        td_dot_coln:   td_dot_coln   { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_DOT>,  <&kp ES_COLN>;  };
        td_comm_semi:  td_comm_semi  { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_COMM>, <&kp ES_SEMI>;  };
        td_mi_un:      td_mi_un      { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <180>; bindings = <&kp ES_UNDS>, <&kp ES_MINS>;  };
        td_sl_bs:      td_sl_bs      { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_SLSH>, <&kp RA(NON_US_BSLH)>; };
        td_pl_as:      td_pl_as      { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_PLUS>, <&kp ES_ASTR>;  };
        td_amp_pipe:   td_amp_pipe   { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <180>; bindings = <&kp ES_AMPS>, <&kp ES_PIPE>;  };
        td_eql_neq:    td_eql_neq    { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_EQL>,  <&kp ES_EXCL>;  };
        td_dlr_hash:   td_dlr_hash   { compatible = "zmk,behavior-tap-dance"; #ng-term-ms = <180>; bindings = <&kp ES_DLR>,  <&kp ES_HASH>;  };
        td_ique_ques:  td_ique_ques  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <180>; bindings = <&kp ES_QUES>, <&kp ES_IQUE>;  };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q              &kp W         &kp E         &kp R         &kp T                  &kp I         &kp O         &kp P
&hm_shift LSHFT A  &hm LALT S    &hm LCTRL D   &hm LGUI F    &kp G                &kp H         &hm RGUI J    &hm RCTRL K   &hm LALT L    &td_u_at
&kp Z              &kp X         &kp C         &kp V         &kp B                  &kp COMMA     &kp DOT       &to_l3
                                 &lt 1 BSPC    &lt 2 TAB     &to_l3            CE
            >;
        };

        layer_1 {
            bindings = <
&kp ESC            &m_backticks  &m_s_quotes   &m_quotes     &kp LG(LS(N4))    ques  &td_comm_semi &td_sl_bs     &kp ESC
&none              &m_braces     &m_brackets   &m_parens     &none                &m_quotes     &td_perc_caret &td_dot_coln  &td_pl_as     &td_mi_un
&none              &none         &none         &m_angle      &none                &m_s_quotes   &td_amp_pipe   &td_eql_neq   &td_dlr_hash  &td_comm_dot
                                 &to_l0        &to_l0        &kp BSPC             &kp RET       &kp SPACE
            >;
        };

        layer_2 {
            bindings = <
&none              &kp N7        &kp N8        &kp N9        &kp HOME               &none         &none         &kp PG_UP
&none              &kp N4        &kp N5        &kp N6        &kp N0                 &kp UP        &kp RIGHT     &kp PG_DN
&none              &kp N1        &kp N2        &kp N3        &none                &none         &none         &none         &to_l0        &none
                                 &to_l0        &to_l0        &kp BSPC             &kp RET       &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
&bootloader        &none         &none         &none         &none                &none              &none              &none              &none             &bootloader
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3         &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_HUI    &rgb_ug RGB_BRI   &none
&none              &none         &none         &none         &none             _ug RGB_HUD    &rgb_ug RGB_BRD    &none             &to_l0
                                 &none         &none         &none             e
            >;
        };

        layer_4 {
            bindings = <
&none              &none         &none         &none         &mo 5                  &none         &none         &none
&none              &kp LG(X)     &kp LG(V)     &kp LG(C)     &msc SCRL_DOWN       &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &none
&none              &none         &none         &none         &msc SCRL_UP           &none         &tog 4        &none
                                 &mkp LCLK     &mkp RCLK     &mkp MCLK
            >;
        };

        layer_5 {
            bindings = <
&none              &none              &mmv MOVE_UP       &none              &no      &none         &none         &none         &none
&none              &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_RIGHT    &none                &none         &none         &none         &none         &none
&to_l0             &none              &none              &none              &no      &none         &none         &none         &none
                                      &mkp LCLK          &mkp RCLK          &no      &none
            >;
        };
    };
};

Resumen: capas 0-2 ya idénticas al .vil, layer_3/4/5 intactas como pediste, y el único bug real (tap dances duplicados) queda arreglado en esta versión.

✻ Churned for 1m 24s

❯ cuántos cambios has metido en cada capa? hazme un resumen para hacerme a la idea si habían muchas cosas diferentes

Resumen de cuántas teclas cambiaron por capa (sobre 35 posiciones por capa: 30  pulgares):
&none              &kp N7        &kp N8        &kp N9        &kp HOME             &kp END       &none         &none         &none         &kp PG_UP
&none              &kp N4        &kp N5        &kp N6        &kp N0               &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp PG_DN
&none              &kp N1        &kp N2        &kp N3        &none                &none         &none         &none         &to_l0        &none
                                 &to_l0        &to_l0        &kp BSPC             &kp RET       &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
&bootloader        &none         &none         &none         &none                &none              &none              &none              &none             &bootloader
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3         &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_HUI    &rgb_ug RGB_BRI   &none
&none              &none         &none         &none         &none                &none              &rgb_ug RGB_HUD    &rgb_ug RGB_BRD    &none             &to_l0
                                 &none         &none         &none                &none              &none
            >;
        };

        layer_4 {
            bindings = <
&none              &none         &none         &none         &mo 5                &none         &none         &none         &none         &none
&none              &kp LG(X)     &kp LG(V)     &kp LG(C)     &msc SCRL_DOWN       &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &none
&none              &none         &none         &none         &msc SCRL_UP         &none         &none         &none         &tog 4        &none
                                 &mkp LCLK     &mkp RCLK     &mkp MCLK            &none         &none
            >;
        };

        layer_5 {
            bindings = <
&none              &none              &mmv MOVE_UP       &none              &none                &none         &none         &none         &none         &none
&none              &mmv MOVE_LEFT     &mmv MOVE_DOWN     &mmv MOVE_RIGHT    &none                &none         &none         &none         &none         &none
&to_l0             &none              &none              &none              &no      &none         &none         &none         &none
                                      &mkp LCLK          &mkp RCLK          &none                &none         &none
            >;
        };
    };
};
