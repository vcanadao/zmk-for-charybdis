#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

/* --- COLORES --- */
#define LILA      280
#define AZUL      240
#define ROJO      0
#define AMARILLO  60
#define VERDE     120

/* --- DEFINICIONES MAC ESPAÑOL --- */
#define ES_CARET  LS(LBKT)
#define ES_PERC   LS(N5)
#define ES_TILDE  RA(SEMI)
#define ES_ACUTE  SQT
#define ES_AT     RA(N2)
#define ES_SEMI   LS(COMMA)
#define ES_EQL    LS(N0)
#define ES_PIPE   RA(N1)
#define ES_SLSH   LS(N7)
#define ES_UNDS   LS(SLASH)
#define ES_HASH   RA(N3)
#define ES_EXCL   LS(N1)
#define ES_COLN   LS(DOT)
#define ES_DOT    DOT
#define ES_COMM   COMMA
#define ES_AMPS   LS(N6)
#define ES_MINS   SLASH
#define ES_PLUS   RBKT
#define ES_ASTR   LS(RBKT)
#define ES_LPAR   LS(N8)
#define ES_RPAR   LS(N9)
#define ES_LABK   GRAVE
#define ES_RABK   LS(GRAVE)
#define ES_QUES   LS(MINUS)
#define ES_BSLH   RA(NON_US_BSLH)
#define ES_DLR    LS(N4)
#define ES_IQUE   LS(EQUAL)
#define ES_LBRC   RA(SQT)
#define ES_RBRC   RA(BSLH)
#define ES_LBKT   RA(LBKT)
#define ES_RBKT   RA(RBKT)
#define ES_DQUO   LS(N2)
#define ES_SQUO   MINUS
#define ES_GRV_D  LBKT

/ {
    macros {
        to_l1: to_l1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&to 1>
                , <&macro_wait_time 30>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(AZUL,100,50)>;
        };

        to_l2: to_l2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&to 2>
                , <&macro_wait_time 30>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(ROJO,100,50)>;
        };

        to_l3: to_l3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&to 3>
                , <&macro_wait_time 30>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(AMARILLO,100,50)>;
        };

        to_l4: to_l4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&to 4>
                , <&macro_wait_time 30>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(VERDE,100,50)>;
        };

        to_l0: to_l0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&to 0>
                , <&macro_wait_time 30>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        /* --- Macros momentaneos con cambio de color CORREGIDOS --- */
        mo_l1_c: mo_l1_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(AZUL,100,50)>
                , <&macro_press>, <&mo 1>
                , <&macro_pause_for_release>
                , <&macro_release>, <&mo 1>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        mo_l2_c: mo_l2_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(ROJO,100,50)>
                , <&macro_press>, <&mo 2>
                , <&macro_pause_for_release>
                , <&macro_release>, <&mo 2>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        mo_l3_c: mo_l3_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(AMARILLO,100,50)>
                , <&macro_press>, <&mo 3>
                , <&macro_pause_for_release>
                , <&macro_release>, <&mo 3>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        mo_l4_c: mo_l4_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(VERDE,100,50)>
                , <&macro_press>, <&mo 4>
                , <&macro_pause_for_release>
                , <&macro_release>, <&mo 4>
                , <&macro_tap>, <&rgb_ug RGB_COLOR_HSB(LILA,100,50)>;
        };

        m_angle:     m_angle     { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ES_LABK>, <&kp ES_RABK>, <&kp LEFT>; };
        m_parens:    m_parens    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ES_LPAR>, <&kp ES_RPAR>, <&kp LEFT>; };
        m_braces:    m_braces    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(LBKT)>, <&kp RA(RBKT)>, <&kp LEFT>; };
        m_brackets:  m_brackets  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(SQT)>, <&kp RA(BSLH)>, <&kp LEFT>; };
        m_quotes:    m_quotes    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(N2)>, <&kp LS(N2)>, <&kp LEFT>; };
        m_s_quotes:  m_s_quotes  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SQT>, <&kp SQT>, <&kp LEFT>; };
        m_backticks: m_backticks { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(LBKT)>, <&kp LS(LBKT)>, <&kp LEFT>; };
        m_tilde:     m_tilde     { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ES_TILDE>, <&kp SPACE>; };
        m_grave:     m_grave     { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ES_GRV_D>, <&kp SPACE>; };
        m_caret:     m_caret     { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ES_CARET>, <&kp SPACE>; };

    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        hm_shift: homerow_mods_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        /* --- Hold-taps momentaneos CORREGIDOS: más rápidos (120ms) + retro-tap --- */
        lt_c1: lt_colored_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <125>;
            retro-tap;
            bindings = <&mo_l1_c>, <&kp>;
        };

        lt_c2: lt_colored_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <125>;
            retro-tap;
            bindings = <&mo_l2_c>, <&kp>;
        };

        ht_l3: ht_layer3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <125>;
            retro-tap;
            bindings = <&mo_l3_c>, <&kp>;
        };

        ht_l4: ht_layer4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <125>;
            retro-tap;
            bindings = <&mo_l4_c>, <&kp>;
        };

        lt_bspc: lt_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        td_u_at:       td_u_at       { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <160>; bindings = <&kp U>, <&kp ES_AT>; };
        td_perc_caret: td_perc_caret { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_PERC>, <&kp ES_CARET>; };
        td_dot_coln:   td_dot_coln   { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_DOT>,  <&kp ES_COLN>;  };
        td_comm_semi:  td_comm_semi  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_COMM>, <&kp ES_SEMI>;  };
        td_mi_un:      td_mi_un      { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_UNDS>, <&kp ES_MINS>;  };
        td_sl_bs:      td_sl_bs      { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_SLSH>, <&kp ES_BSLH>;  };
        td_pl_as:      td_pl_as      { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_PLUS>, <&kp ES_ASTR>;  };
        td_amp_pipe:   td_amp_pipe   { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_AMPS>, <&kp ES_PIPE>;  };
        td_eql_neq:    td_eql_neq    { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_EQL>,  <&kp ES_EXCL>;  };
        td_dlr_hash:   td_dlr_hash   { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_DLR>,  <&kp ES_HASH>;  };
        td_ique_ques:  td_ique_ques  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp ES_QUES>, <&kp ES_IQUE>;  };
        td_ene:        td_ene        { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp SEMI>,    <&m_tilde>;     };
        td_y:          td_y          { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp Y>,       <&kp ES_ACUTE>; };
        td_comm_dot:   td_comm_dot   { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <180>; bindings = <&kp ES_COMM>, <&kp ES_DOT>;   };
        td_u_til:      td_u_til      { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <150>; bindings = <&kp U>, <&m_tilde>;           };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
            &kp Q                &kp W            &kp E            &kp R             &kp T                 &td_y             &td_u_at          &kp I             &kp O             &kp P
            &hm_shift LSHFT A    &hm LALT S       &hm LCTRL D      &hm LGUI F        &kp G                 &kp H             &hm RGUI J        &hm RCTRL K       &hm LALT L        &hm_shift RSHFT ES_QUES
            &kp Z                &kp X            &kp C            &kp V             &kp B                 &kp N             &kp M             &kp COMMA         &kp DOT           &to_l3
                                                  &lt_bspc 1 BSPC  &lt 2 TAB         &to_l4                &lt 2 RET         &lt 1 SPACE
            >;
        };
        layer_1 {
            bindings = <
            &kp ES_HASH          &m_grave         &kp ES_LBRC      &kp ES_RBRC       &kp ES_AMPS           &kp ES_PERC       &kp ES_QUES       &kp ES_LABK       &kp ES_SLSH       &kp ES_SEMI
            &kp ES_DLR           &kp ES_DQUO      &kp ES_LPAR      &kp ES_RPAR       &kp ES_AT             &kp ES_COLN       &kp ES_EQL        &kp ES_RABK       &kp ES_MINS       &kp ES_UNDS
            &kp ES_BSLH          &kp ES_SQUO      &kp ES_LBKT      &kp ES_RBKT       &kp ES_PIPE           &m_tilde          &kp ES_ASTR       &kp ES_PLUS       &kp ES_EXCL       &kp SEMI
                                                  &to_l0           &to_l0            &kp BSPC              &kp RET           &kp SPACE
            >;
        };

        layer_2 {
            bindings = <
            &kp ESC              &kp N7           &kp N8           &kp N9            &kp HOME              &kp END           &m_caret          &none             &none             &kp PG_UP
            &none                &kp N4           &kp N5           &kp N6            &kp N0                &kp LEFT          &kp DOWN          &kp UP            &kp RIGHT         &kp PG_DN
            &none                &kp N1           &kp N2           &kp N3            &none                 &none             &none             &none             &to_l0            &none
                                                  &to_l0           &to_l0            &kp BSPC              &kp RET           &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
            &bootloader          &none            &none            &none             &none                 &none             &none             &none             &none             &bootloader
            &bt BT_CLR           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2      &bt BT_SEL 3          &rgb_ug RGB_TOG   &rgb_ug RGB_EFF   &rgb_ug RGB_HUI   &rgb_ug RGB_BRI   &none
            &none                &none            &none            &none             &none                 &none             &rgb_ug RGB_HUD   &rgb_ug RGB_BRD   &none             &to_l0
                                                  &none            &none             &none                 &none             &to_l0
            >;
        };

        layer_4 {
            bindings = <
            &none                &none            &none            &none             &mo 5                 &none             &none             &none             &none             &none
            &none                &kp LG(X)        &kp LG(V)        &kp LG(C)         &msc SCRL_DOWN        &none             &none             &none             &none             &none
            &none                &none            &none            &none             &msc SCRL_UP          &none             &none             &none             &none             &none
                                                  &mkp LCLK        &mkp RCLK         &mkp MCLK             &none             &to_l0
            >;
        };

        layer_5 {
            bindings = <
            &none                &none            &mmv MOVE_UP     &none             &none                 &none             &none             &none             &none             &none
            &none                &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT   &none                 &kp LEFT          &kp DOWN          &kp UP            &kp RIGHT         &none
            &to_l0               &none            &none            &none             &none                 &none             &none             &none             &none             &none
                                                  &mkp LCLK        &mkp RCLK         &none                 &none             &none
            >;
        };
    };
};
